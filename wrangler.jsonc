{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen-notes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rss.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lumen-notes", "database_id": "ca71c018-7d95-45e7-85b7-fb8fd5dafffc", "migrations_dir": "migrations" },
    // Second account (its own passcode, secret ROADMAP_PASSCODE): same schema, fully separate data. See worker/accounts.ts.
    { "binding": "DB_ROADMAP", "database_name": "lumen-roadmap", "database_id": "76ffb43d-6716-4474-9142-6771800b7b11", "migrations_dir": "migrations" }
  ],
  // Attachments are stored free in D1 as 1.5 MB parts (max 100 MB per file, 5 GB total on the free plan).
  // Optional R2 (needs a card on the Cloudflare account): create bucket lumen-notes-files and uncomment.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "lumen-notes-files" }],
  "ai": { "binding": "AI" },
  // Phone-as-remote for slides: one SQLite-backed Durable Object per pairing code (free plan), WebSocket hibernation.
  "durable_objects": { "bindings": [{ "name": "REMOTE", "class_name": "SlidesRemote" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlidesRemote"] }],
  "vars": { "BLOG_NAME": "Lumen" },
  "observability": { "enabled": true }
}
