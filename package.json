{
  "name": "lumen-notes",
  "version": "1.0.0",
  "description": "Lumen: local-first study notes, canvas & personal blog (Markdown, Mermaid, LaTeX). Cloudflare Workers + D1, Android via Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply lumen-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumen-notes --remote",
    "android:sync": "npm run build:app && cap sync android",
    "android:open": "cap open android"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^6.2.3",
    "@capgo/capacitor-native-biometric": "6.0.4",
    "@cloudflare/puppeteer": "2.0.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^3.6.0",
    "@types/rbush": "4.0.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@xyflow/react": "^12.12.1",
    "d3-force": "^3.0.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "elkjs": "^0.12.1",
    "fractional-indexing": "^3.2.0",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "pagedjs": "0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "perfect-freehand": "^1.2.0",
    "qrcode": "^1.5.4",
    "rbush": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "send-intent": "6.0.3",
    "sql.js": "^1.17.0",
    "svg2pdf.js": "^2.9.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-force": "^3.0.10",
    "@types/diff": "^7.0.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "linkedom": "^0.18.12",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  },
  "private": true
}
