{"shell":"<helmet>\n<meta name=\"design_doc_mode\" content=\"canvas\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400&display=swap\" rel=\"stylesheet\">\n<style>html,body{margin:0;background:#202227;-webkit-font-smoothing:antialiased}a{color:#5CC8C2}a:hover{color:#8EDDD8}</style>\n</helmet>\n<div style=\"padding:80px;display:flex;flex-direction:column;gap:110px;font-family:Inter,system-ui,sans-serif;color:#E8E6E1;width:max-content;min-height:100vh;background:#202227;font-size:13px\">\n  <div style=\"display:flex;align-items:center;gap:16px\">\n    <dc-import name=\"LumenMark\" size=\"{{ 40 }}\" hint-size=\"40px,40px\"></dc-import>\n    <div style=\"display:flex;flex-direction:column;gap:4px\"><div style=\"font-size:26px;font-weight:600;letter-spacing:-.04em\">lumen <span style=\"color:#7D7A73;font-weight:450;letter-spacing:-.01em\">/ {{ pageTitle }}</span></div><div style=\"font-size:14px;color:#9A9890;max-width:1100px\">{{ pageDesc }}</div></div>\n  </div>\n  <section style=\"display:{{ fixS }};flex-direction:column;gap:14px;max-width:1100px\">\n    <div style=\"font:500 12px 'JetBrains Mono',monospace;color:#F25C9A;letter-spacing:.08em\">{{ fixH }}</div>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px 28px;font-size:14px;line-height:21px;color:#CFCBC3\"><sc-for list=\"{{ fixes }}\" as=\"f\"><div style=\"display:flex;gap:10px\"><b style=\"color:#F25C9A\">·</b><span><b style=\"color:#ECE9E2\">{{ f.a }}</b> {{ f.b }}</span></div></sc-for></div>\n  </section>\n  <sc-for list=\"{{ sections }}\" as=\"sec\" hint-placeholder-count=\"2\">\n    <section style=\"display:flex;flex-direction:column;gap:28px\">\n      <div style=\"display:flex;flex-direction:column;gap:6px;max-width:960px\"><div style=\"font:500 12px 'JetBrains Mono',monospace;color:#F25C9A;letter-spacing:.08em\">{{ sec.k }}</div><h2 style=\"margin:0;font-size:32px;font-weight:650;letter-spacing:-.02em;color:#ECE9E2\">{{ sec.t }}</h2><p style=\"margin:0;color:#9A9890;font-size:15px;line-height:24px\">{{ sec.d }}</p></div>\n      <div style=\"display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start\">\n        <sc-for list=\"{{ sec.frames }}\" as=\"f\" hint-placeholder-count=\"2\">\n          <div style=\"display:flex;flex-direction:column;gap:12px\">\n            <div style=\"font:500 13px 'JetBrains Mono',monospace;color:#B9B5AC;white-space:nowrap\"><span style=\"color:#F25C9A\">{{ f.id }}</span> {{ f.l }}</div>\n            <div style=\"--bg:{{ f.t.bg }};--sf:{{ f.t.sf }};--sf2:{{ f.t.sf2 }};--bd:{{ f.t.bd }};--tx:{{ f.t.tx }};--mu:{{ f.t.mu }};--ac:{{ f.t.ac }};--af:{{ f.t.af }};--ln:{{ f.t.ln }};--ok:{{ f.t.ok }};--wa:{{ f.t.wa }};--da:{{ f.t.da }};--le:{{ f.t.le }};width:{{ f.w }};height:{{ f.h }};position:relative;overflow:hidden;border-radius:{{ f.r }};background:var(--bg)\">\n              <dc-import name=\"__COMP__\" __PROPS__ phone=\"{{ f.ph }}\" light=\"{{ f.light }}\" hint-size=\"100%,100%\" style=\"position:absolute;inset:0\"></dc-import>\n            </div>\n            <div style=\"max-width:{{ f.w }};font-size:13px;line-height:20px;color:#CFCBC3;display:{{ f.nS }};gap:10px\"><b style=\"color:#F25C9A\">·</b><span>{{ f.n }}</span></div>\n          </div>\n        </sc-for>\n      </div>\n    </section>\n  </sc-for>\n</div>","logic":"class Component extends DCLogic {\n  renderVals() {\n    const L = { bg:'#0F1115', sf:'#161A21', sf2:'#1D222B', bd:'#2A303B', tx:'#E8E6E1', mu:'#9AA0AA', ac:'#F2A93B', af:'#1A1206', ln:'#5CC8C2', ok:'#6BCB8B', wa:'#E8B34A', da:'#EF6B6B', le:'#B48EF0' };\n    const P = { bg:'#FAF8F3', sf:'#FFFFFF', sf2:'#F2EFE7', bd:'#E4DFD3', tx:'#1F1D1A', mu:'#6A655C', ac:'#B45F0E', af:'#FFFFFF', ln:'#0F7C78', ok:'#1F8A4C', wa:'#A86A00', da:'#C42B2B', le:'#7A4BD1' };\n    const F = (id, l, t, n, o = {}) => ({ id, l, t, n, nS: n ? 'flex' : 'none', o, ph: !!o.ph, light: t === P, w: o.ph ? '412px' : '1440px', h: o.ph ? '915px' : (o.h || '900px'), r: o.ph ? '28px' : '12px' });\n__BODY__\n  }\n}"}